rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isFamily() {
      return request.auth != null && request.auth.token.email in [
        "smjoshi@gmail.com",
        "bioconcepts.pune@gmail.com",
        "saee1175@gmail.com",
        "gjoshi1208@gmail.com"
      ];
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function emailMatchesAuth(field) {
      return field == request.auth.token.email;
    }

    // Location records: only family members (and only the owner) may write their own.
    match /locations/{uid} {
      allow read: if isFamily();

      // Parent doc may only contain { email, uid }; email must match the caller.
      allow write: if isFamily() && isOwner(uid)
        && request.resource.data.keys().hasOnly(['email', 'uid'])
        && request.resource.data.uid == uid
        && emailMatchesAuth(request.resource.data.email);

      match /records/{recordId} {
        allow read: if isFamily();

        // Append-only: validated create, no edits or deletes.
        allow create: if isFamily() && isOwner(uid)
          && request.resource.data.keys().hasOnly(
               ['lat', 'lon', 'timestamp', 'accuracy', 'speed', 'altitude', 'bearing', 'email'])
          && emailMatchesAuth(request.resource.data.email)
          && request.resource.data.lat is number
          && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
          && request.resource.data.lon is number
          && request.resource.data.lon >= -180 && request.resource.data.lon <= 180
          && request.resource.data.timestamp is number
          && request.resource.data.accuracy is number
          && request.resource.data.speed is number
          && request.resource.data.altitude is number
          && (request.resource.data.bearing == null || request.resource.data.bearing is number);
        allow update, delete: if false;
      }
    }

    // Express sync: a family member may only write their OWN doc with a valid start/stop payload.
    match /express_sync/{docId} {
      allow read: if isFamily();

      allow write: if isFamily() && docId == request.auth.uid
        && (
          // START request
          (request.resource.data.keys().hasOnly(['requestedBy', 'expiresAt', 'requestedAt'])
            && emailMatchesAuth(request.resource.data.requestedBy)
            && request.resource.data.expiresAt is number
            && request.resource.data.expiresAt > request.time.toMillis()
            && request.resource.data.expiresAt <= request.time.toMillis() + 3700000)
          ||
          // STOP request
          (request.resource.data.keys().hasOnly(['action', 'stoppedBy', 'stoppedAt'])
            && request.resource.data.action == 'stop'
            && emailMatchesAuth(request.resource.data.stoppedBy))
        );
    }
  }
}